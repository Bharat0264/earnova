# Copy to .env for local development. Never commit real credentials.
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/earnova
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=7d
# Production auth uses a secure HTTP-only cookie. Set AUTH_RETURN_TOKEN only during legacy-client migration.
AUTH_COOKIE_NAME=earnova_session
AUTH_COOKIE_MAX_AGE_SECONDS=86400
AUTH_COOKIE_SAME_SITE=None
AUTH_RETURN_TOKEN=false
# Production automatically uses the shared MongoDB rate-limit store.
RATE_LIMIT_STORE=mongodb
RAZORPAY_KEY_ID=replace_with_test_key_id
RAZORPAY_KEY_SECRET=replace_with_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_test_webhook_secret
RAZORPAY_ACCOUNT_NUMBER=replace_with_account_number
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=replace_with_email_user
EMAIL_PASS=replace_with_email_password
EMAIL_FROM=Earnova <noreply@earnova.in>
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret
# Leave unset to quarantine sensitive uploads until an external scanner is integrated.
MALWARE_SCANNER_MODE=quarantine
VITE_API_BASE=/api
# Never enable this in production. It allows selected screens to show demo fixtures.
VITE_DEMO_MODE=false
# Google OAuth Web Client ID. This identifier is public; never expose a client secret in Vite.
VITE_GOOGLE_CLIENT_ID=replace_with_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=replace_with_google_web_client_id.apps.googleusercontent.com
