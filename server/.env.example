# Earnova Server Environment Variables
# Copy this file to .env and fill in real values.
# Never commit server/.env to version control.

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
# Local example:
MONGO_URI=mongodb://127.0.0.1:27017/earnova
# Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/earnova

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Google Identity Services (same Web Client ID used by the frontend)
GOOGLE_CLIENT_ID=replace_with_google_web_client_id.apps.googleusercontent.com

# Razorpay Checkout
# Use matching test or live keys from the same Razorpay account.
RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# Email / Nodemailer
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=replace_with_email_app_password
EMAIL_FROM=Earnova <noreply@earnova.in>

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Sensitive uploads remain quarantined unless a trusted provider-side scanner is configured.
# Set to trusted_provider only after the storage account has a verified malware-scanning workflow.
MALWARE_SCANNER_MODE=quarantine

# Razorpay Payouts (Referral withdrawals)
RAZORPAY_ACCOUNT_NUMBER=your_razorpay_account_number
