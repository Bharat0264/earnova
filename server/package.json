{
  "name": "earnova-server",
  "version": "1.0.0",
  "description": "Earnova Backend REST API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src test scripts",
    "typecheck": "node scripts/check-syntax.mjs",
    "test": "node --test test/*.test.js",
    "seed": "node src/data/seed.js",
    "seed:clear": "node src/data/seed.js --clear",
    "create-admin": "node src/data/createAdmin.js",
    "migrate:onboarding": "node src/data/backfillOnboarding.js",
    "migrate:ca-support": "node src/data/migrateCAAndSupportPhase1.js",
    "migrate:platform-products": "node src/data/migratePlatformProducts.js",
    "configure:platform-fulfilment": "node src/data/configurePlatformFulfilment.js",
    "seed:operations": "node src/data/seedOperations.js",
    "smoke:engine": "node scripts/smoke-engine.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "google-auth-library": "^10.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "razorpay": "^2.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "nodemon": "^3.0.2"
  }
}
